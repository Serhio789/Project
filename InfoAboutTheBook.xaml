<Window x:Class="WPFBookStore.InfoAboutTheBook"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      mc:Ignorable="d"
      Title="InfoAboutTheBook"
      d:DesignHeight="600" d:DesignWidth="800">

    <Grid Background="{DynamicResource PrimaryBackgroundColor}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Верхняя панель -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="10" VerticalAlignment="Center">
            <Button x:Name="BackButton" Content="Назад" Click="BackButton_Click" 
                    Padding="10 5" Margin="5" Background="{DynamicResource SecundaryBackgroundColor}"
                    Foreground="White"/>
            <TextBlock x:Name="TitleText" Text="{Binding Title}" FontSize="20" Margin="10" 
                       Foreground="White" VerticalAlignment="Center"/>
        </StackPanel>

        <!-- Основной контент -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <Grid Margin="10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="2*"/>
                </Grid.ColumnDefinitions>

                <!-- Обложка -->
                <Image Grid.Column="0" Source="{Binding Cover}" 
                       Stretch="Uniform" Margin="10" HorizontalAlignment="Center"/>

                <!-- Метаданные -->
                <StackPanel Grid.Column="1" Margin="10">
                    <TextBlock Text="{Binding Author.LastNameAutor}" FontSize="16" Margin="0 5" Foreground="White"/>
                    <TextBlock Text="{Binding Year}" FontSize="16" Margin="0 5" Foreground="White"/>
                    <TextBlock Text="{Binding Genre.Name}" FontSize="16" Margin="0 5" Foreground="White"/>
                    <!-- Добавьте другие поля по необходимости -->
                </StackPanel>
            </Grid>
        </ScrollViewer>

        <!-- Кнопка действий -->
        <Button x:Name="ActionButton" Grid.Row="1" Content="Добавить" Click="ActionButton_Click" 
                HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="20" Padding="20 5"
                Background="{DynamicResource SecundaryBackgroundColor}" Foreground="White"/>
    </Grid>
</Window>