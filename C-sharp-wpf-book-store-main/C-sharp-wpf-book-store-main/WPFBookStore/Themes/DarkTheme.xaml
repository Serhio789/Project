<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Background Colors -->
    <SolidColorBrush x:Key="PrimaryBackgroundColor" Color="#ff945b"/>
    <SolidColorBrush x:Key="SecundaryBackgroundColor" Color="#663b24"/>

    <!-- Primary Colors -->
    <SolidColorBrush x:Key="PrimaryBlueColor" Color="#ff5900"/>

    <!-- Typograhy Colors -->
    <SolidColorBrush x:Key="PrimaryTextColor" Color="White"/>
    <SolidColorBrush x:Key="TextSecundaryColor" Color="#ff5900"/>
    <SolidColorBrush x:Key="TextTertiaryColor" Color="#555"/>
    <SolidColorBrush x:Key="TextFourthColor" Color="#ff5900"/>

    <!-- Icon Colors -->
    <SolidColorBrush x:Key="PrimaryIconColor" Color="#858fa2"/>
    <SolidColorBrush x:Key="SecundaryIconColor" Color="#ff945b"/>
    <SolidColorBrush x:Key="TertiarIconyColor" Color="#D46A38"/>
    <SolidColorBrush x:Key="FourthIconColor" Color="#663b24"/>

    <SolidColorBrush x:Key="btnClose" Color="#F72626"/>


</ResourceDictionary>