<Page x:Class="WPFBookStore.Pages.Home"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:WPFBookStore.Pages"
      mc:Ignorable="d" 
      Height="650" Width="1000"
      Title="Личный кабинет">

    <Grid>
        <ScrollViewer x:Name="MyScrollViewer" VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
            <StackPanel>
                <Label Content="Мои книги" HorizontalAlignment="Center" Height="30" Margin="0,170,0,0" VerticalAlignment="Top" Width="70"/>
                <!-- Здесь много элементов для прокрутки -->
                
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>