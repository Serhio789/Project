<Page x:Class="WPFBookStore.Pages.Dashboard"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:WPFBookStore.Pages"
      mc:Ignorable="d" Width="935" Height="560"
      Title="Чтение книг" Loaded="Page_Loaded">



    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Border Grid.Column="1"
                    Background="#ff945b"
                    CornerRadius="0 0 0 0" Margin="0,0,0,0">
            <TextBlock x:Name="TextFromBook" HorizontalAlignment="Center" Height="440" Margin="43,60,42.2,0" TextWrapping="Wrap" Text="Текст Книги" VerticalAlignment="Top" Width="850" FontSize="16" FontFamily ="Inter"/>
        </Border>
        <!--<TextBlock Grid.ColumnSpan="2" Text="BOBAREADER" FontSize="32" Foreground="{DynamicResource PrimaryTextColor}" FontWeight="Bold" 
                VerticalAlignment="Top" HorizontalAlignment="Left" Margin="40,20,0,0" FontFamily ="Inter"/>-->
        <Label x:Name="NameBook" Grid.ColumnSpan="2" Content="Название книги" FontSize="32" Foreground="{DynamicResource PrimaryTextColor}" FontWeight="Bold" 
                VerticalAlignment="Top" HorizontalAlignment="Center" FontFamily ="Inter"/>
        <Label x:Name="NumberPageFromBook" Grid.ColumnSpan="2" Content="N" HorizontalAlignment="Right" Height="30" Margin="0,500,50,30" Width="50" FontSize="18" />


    </Grid>






</Page>
