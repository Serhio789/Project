<Page x:Class="WPFBookStore.Pages.Dashboard"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:WPFBookStore.Pages"
      mc:Ignorable="d" Width="1000" Height="650"
      Title="Чтение книг" Loaded="Page_Loaded">


    <Border CornerRadius="0,0,0,25" Background="{DynamicResource SecundaryBackgroundColor}" Height="650" Width="1000">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Border Grid.Column="1"
                    Background="#ff945b"
                    CornerRadius="25 0 0 8" Width="1000" Margin="0,90,0,0">
                <TextBlock x:Name="TextFromBook" HorizontalAlignment="Center" Height="360" Margin="60,60,60,0" TextWrapping="Wrap" Text="Текст Книги" VerticalAlignment="Top" Width="850"/>
            </Border>
            <TextBlock Grid.ColumnSpan="2" Text="BOBAREADER" FontSize="32" Foreground="{DynamicResource PrimaryTextColor}" FontWeight="Bold" 
                VerticalAlignment="Top" HorizontalAlignment="Left" Margin="40,20,0,0" FontFamily ="Inter"/>
            <Label x:Name="NameBook" Grid.ColumnSpan="2" Content="Название книги" FontSize="32" Foreground="{DynamicResource PrimaryTextColor}" FontWeight="Bold" 
                VerticalAlignment="Top" HorizontalAlignment="Center" Margin="0,90,0,0" FontFamily ="Inter"/>
            <Label x:Name="NumberPageFromBook" Grid.ColumnSpan="2" Content="Номер страницы" HorizontalAlignment="Right" Height="30" Margin="0,550,90,0" VerticalAlignment="Top" Width="105"/>


        </Grid>
    </Border>





</Page>
