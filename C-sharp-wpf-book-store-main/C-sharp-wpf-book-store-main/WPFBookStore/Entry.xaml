<Window x:Class="WPFBookStore.Entry"
      xmlns:ctls="clr-namespace:WPFBookStore.Controls"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:WPFBookStore"
      mc:Ignorable="d" Name="Start_"
      Height="450" Width="800" MinHeight="600" MinWidth="1000"
      Title="Entry"
      WindowStartupLocation="CenterScreen" WindowStyle="None"
      Background="Transparent" AllowsTransparency="True"
      ResizeMode="NoResize" FontFamily="Poppins">

    <Border Background="{DynamicResource PrimaryBackgroundColor}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <!-- Заголовок -->
                <RowDefinition Height="*"/>
                <!-- Основное содержимое -->
                <RowDefinition Height="Auto"/>
                <!-- Кнопки -->
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Логотип -->
            <Border Grid.Row="0" Grid.RowSpan="3"
                    Background="{DynamicResource SecundaryBackgroundColor}"
                    CornerRadius="0 0 0 0" VerticalAlignment="Top" Margin="0">
                <Viewbox Stretch="Uniform" Margin="160,40,160,15 " VerticalAlignment="Center">
                    <Image Source="Resources/BOBAREADER.png" />
                </Viewbox>
            </Border>

            <!-- Поля ввода -->
            <StackPanel Grid.Column="0" Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Center">
                <StackPanel Orientation="Vertical" HorizontalAlignment="Center" Margin="0,0,0,0">
                    <Border CornerRadius="10" BorderThickness="1" Background="White" Margin="0,0,0,10">
                        <TextBox Width="250" Height="30" Text="Логин" Margin="2" 
                     FontFamily="Inter" Background="Transparent" 
                     BorderThickness="0" Padding="6"/>
                    </Border>

                    <Border CornerRadius="10" BorderThickness="1" Background="White">
                        <TextBox Width="250" Height="30" Text="Пароль" Margin="2" 
                     FontFamily="Inter" Background="Transparent" 
                     BorderThickness="0" Padding="6"/>
                    </Border>
                </StackPanel>
            </StackPanel>

            <!-- Кнопки входа и выхода -->
            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,20">
                <Button Content="Выход" Width="160" Height="45" Margin="0,0,20,0" FontFamily="Inter" 
                        Background="{DynamicResource SecundaryBackgroundColor}" 
                        Foreground="{DynamicResource PrimaryBackgroundColor}" BorderBrush="#aaa" BorderThickness="1" Padding="10,5" Click="Exit_Click"/>
                <Button Content="Вход" Width="160" Height="45" FontFamily="Inter" 
                        Background="{DynamicResource SecundaryBackgroundColor}" 
                        Foreground="{DynamicResource PrimaryBackgroundColor}" BorderBrush="#aaa" BorderThickness="1" Padding="10,5" Click="OpenMainWindow_Click"/>
            </StackPanel>

            <!-- Кнопки управления окном (Минимизировать, Восстановить, Закрыть) -->
            <Grid Margin="0,0,0,0">
                <StackPanel Grid.Row="0" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,5,10,0" Height="30" Orientation="Horizontal" FlowDirection="RightToLeft" Grid.RowSpan="2">
                    <Button x:Name="btnClose" Style="{StaticResource IconButtonsStyle}" Content="{DynamicResource close}" Click="btnClose_Click" Tag="IsCloseButton" BorderBrush="White" Foreground="Black" Width="30" Height="30" BorderThickness="2" Background="Transparent"/>
                    <Button x:Name="btnRestore" Margin="5,0" Click="btnRestore_Click">
                        <Button.Style>
                            <Style TargetType="{x:Type Button}" BasedOn="{StaticResource IconButtonsStyle}">
                                <Setter Property="Content" Value="{DynamicResource maximize}"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ElementName=home, Path=WindowState}" Value="Maximized">
                                        <Setter Property="Content" Value="{DynamicResource restore}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                    <Button x:Name="btnMinimize" Style="{DynamicResource IconButtonsStyle}" Content="{DynamicResource minimize}" Click="btnMinimize_Click" Width="30" Height="30" Background="Transparent"/>
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</Window>
