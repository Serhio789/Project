<Page x:Class="WPFBookStore.Pages.Catalog"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      mc:Ignorable="d"
      d:DesignHeight="800" d:DesignWidth="1200"
      Title="Catalog">

    <Grid Background="{DynamicResource PrimaryBackgroundColor}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Фильтры с кнопкой "Стереть" -->
        <StackPanel Grid.Row="0" Margin="20" Orientation="Horizontal">
            <TextBox x:Name="txtTitle" Width="200" Margin="5" 
                     Text="Название" Foreground="Gray"
                     GotFocus="TextBox_GotFocus" LostFocus="TextBox_LostFocus" Height="29"/>

            <ComboBox x:Name="cmbGenre" Width="162" Margin="5" 
                      DisplayMemberPath="Name"
                      SelectedValuePath="IdGenres"/>

            <TextBox x:Name="txtYear" Width="96" Margin="5" 
                     Text="Год" Foreground="Gray"
                     GotFocus="TextBox_GotFocus" LostFocus="TextBox_LostFocus"/>

            <TextBox x:Name="txtAuthor" Width="164" Margin="5" 
                     Text="Автор" Foreground="Gray"
                     GotFocus="TextBox_GotFocus" LostFocus="TextBox_LostFocus"/>

            <Button Content="Поиск" Margin="5" Padding="10,5" 
                    Click="SearchButton_Click" Background="{DynamicResource SecundaryBackgroundColor}" 
                        Foreground="{DynamicResource PrimaryBackgroundColor}" Width="63"/>

            <Button Content="Стереть" Margin="5" Padding="10,5" 
                    Click="ClearButton_Click" Background="{DynamicResource SecundaryBackgroundColor}" 
                        Foreground="{DynamicResource PrimaryBackgroundColor}" Width="64"/>
        </StackPanel>

        <!-- Список книг с вертикальной прокруткой -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <ItemsControl x:Name="BooksItemsControl">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel Orientation="Horizontal"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Width="340" Height="500" Margin="15" 
                                Background="{DynamicResource SecundaryBackgroundColor}"
                                CornerRadius="10"
                                Cursor="Hand">
                            <Border Width="340" Height="500" Margin="15" 
                            Background="{DynamicResource SecundaryBackgroundColor}"
                            CornerRadius="10"
                            Cursor="Hand"
                            PreviewMouseDown="BookItem_PreviewMouseDown">
                                <!-- Остальное содержимое Border -->
                                
                            <StackPanel VerticalAlignment="Top">
                                <!-- Обложка -->
                                <Image Source="{Binding Cover}" 
                                       Height="400" 
                                       Margin="10"
                                       Stretch="UniformToFill"/>

                                <!-- Название с переносом -->
                                <TextBlock Text="{Binding Title}" 
                                           Margin="10,5" 
                                           FontSize="16"
                                           TextWrapping="Wrap"
                                           HorizontalAlignment="Center"
                                           Foreground="White"/>

                                <!-- Автор -->
                                <TextBlock Text="{Binding Author.LastNameAutor}" 
                                           Margin="10,0" 
                                           FontSize="14"
                                           HorizontalAlignment="Center"
                                           Foreground="White"/>
                            </StackPanel>
                        </Border>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <!-- Сообщение об ошибке -->
        <TextBlock x:Name="tbErrorMessage" Grid.Row="1" 
                   Text="По вашему запросу ничего не найдено"
                   Visibility="Collapsed" 
                   HorizontalAlignment="Center" 
                   VerticalAlignment="Center" 
                   FontSize="18"
                   Foreground="White"/>
    </Grid>
    
</Page>