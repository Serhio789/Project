<Page x:Class="WPFBookStore.Pages.Home"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:WPFBookStore.Pages"
      mc:Ignorable="d" 
      Width="935" Height="560"
      Title="Личный кабинет">
    <Grid Background="{DynamicResource PrimaryBackgroundColor}" Margin="10,10,0,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Label Content="Мои книги" HorizontalAlignment="Center" VerticalAlignment="Top"  FontSize="22" FontFamily="Inter"/>

        <!-- Список книг с вертикальной прокруткой -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <ItemsControl x:Name="BooksItemsControl">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel Orientation="Horizontal"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Width="340" Height="500" Margin="15" 
                        Background="{DynamicResource SecundaryBackgroundColor}"
                        CornerRadius="10"
                        Cursor="Hand">
                            <Border Width="340" Height="500" Margin="15" 
                    Background="{DynamicResource SecundaryBackgroundColor}"
                    CornerRadius="10"
                    Cursor="Hand"
                    PreviewMouseDown="BookItem_PreviewMouseDown">
                                <!-- Остальное содержимое Border -->

                                <StackPanel VerticalAlignment="Top">
                                    <!-- Обложка -->
                                    <Image Source="{Binding Cover}" 
                               Height="400" 
                               Margin="10"
                               Stretch="UniformToFill"/>

                                    <!-- Название с переносом -->
                                    <TextBlock Text="{Binding Title}" 
                                   Margin="10,5" 
                                   FontSize="16"
                                   TextWrapping="Wrap"
                                   HorizontalAlignment="Center"
                                   Foreground="White"/>

                                    <!-- Автор -->
                                    <TextBlock Text="{Binding Author.LastNameAutor}" 
                                   Margin="10,0" 
                                   FontSize="14"
                                   HorizontalAlignment="Center"
                                   Foreground="White"/>
                                </StackPanel>
                            </Border>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
        <TextBlock x:Name="tbErrorMessage" Grid.Row="1" 
           Text="У вас нет взятых книг"
           Visibility="Collapsed" 
           HorizontalAlignment="Center" 
           VerticalAlignment="Center" 
           FontSize="18"
           Foreground="White"/>
    </Grid>
</Page>