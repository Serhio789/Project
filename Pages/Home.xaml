<Page x:Class="WPFBookStore.Pages.Home"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:WPFBookStore.Pages"
      mc:Ignorable="d" 
      
      Title="Личный кабинет">
    <Grid Background="{DynamicResource PrimaryBackgroundColor}" Margin="10,10,0,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Label Content="Мои книги" HorizontalAlignment="Center" VerticalAlignment="Top"  FontSize="22" FontFamily="Inter"/>

        <!-- Список книг с вертикальной прокруткой -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <ItemsControl x:Name="BooksItemsControl">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel Orientation="Horizontal"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Width="340" Height="500" Margin="15" 
                                Background="{DynamicResource SecundaryBackgroundColor}"
                                CornerRadius="10"
                                Cursor="Hand"
                                PreviewMouseDown="BookItem_PreviewMouseDown">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="4*"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                
                                <!--Содержимое Книги-->
                                <Image Grid.Row="0" 
                                       Source="{Binding Cover}" 
                                       Margin="5"
                                       Stretch="Uniform"/>

                                <!-- Текстовая информация -->
                                <StackPanel Grid.Row="1" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Title}" 
                                               Margin="10,0" 
                                               FontSize="16"
                                               TextWrapping="Wrap"
                                               TextAlignment="Center"
                                               TextTrimming="CharacterEllipsis"
                                               Foreground="White"/>

                                    <TextBlock Text="{Binding Author.LastNameAutor}" 
                                               Margin="10,5" 
                                               FontSize="14"
                                               TextAlignment="Center"
                                               Foreground="White"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
        <TextBlock x:Name="tbErrorMessage" Grid.Row="1" 
           Text="У вас нет взятых книг"
           Visibility="Collapsed" 
           HorizontalAlignment="Center" 
           VerticalAlignment="Center" 
           FontSize="18"
           Foreground="White"/>
    </Grid>
</Page>