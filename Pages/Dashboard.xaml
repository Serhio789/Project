<Window x:Class="WPFBookStore.Pages.Dashboard"
          xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
  xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
  xmlns:local="clr-namespace:WPFBookStore.Pages"
  mc:Ignorable="d" 
  Title="Чтение книг"
  Loaded="Page_Loaded"
  FontFamily="Inter"
  Background="{DynamicResource PrimaryBackgroundColor}">

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Заголовок книги -->
        <Border Grid.Row="0" Background="{DynamicResource SecundaryBackgroundColor}" CornerRadius="4" Padding="15" Margin="0,0,0,10">
            <TextBlock x:Name="NameBook" 
                 Text="Название книги" 
                 FontSize="24" 
                 FontWeight="SemiBold"
                 Foreground="White"
                 TextAlignment="Center"
                 HorizontalAlignment="Stretch"/>
        </Border>

        <!-- Панель инструментов -->
        <Border Grid.Row="1" Background="{DynamicResource PrimaryBackgroundColor}" CornerRadius="4" Padding="10">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Button x:Name="CloseBookBtn" 
                    Background="{DynamicResource SecundaryBackgroundColor}" 
                    Foreground="{DynamicResource PrimaryBackgroundColor}"
                    Content="Назад" 
                    Click="BackButton_Click"
                    Margin="0,0,15,0"
                    Padding="12,6"/>

                <TextBlock Text="Страница:" 
                       VerticalAlignment="Center"
                       Margin="0,0,5,0"/>

                <TextBox x:Name="PageNumberBox" 
                     Width="60" 
                     VerticalAlignment="Center"
                     
                     Margin="0,0,10,0"/>

                <Button Content="Перейти" 
                    Background="{DynamicResource SecundaryBackgroundColor}" 
                    Foreground="{DynamicResource PrimaryBackgroundColor}"
                    Click="GoToPageBtn_Click"
                    Margin="0,0,15,0"
                    Padding="12,6"/>

                <Separator  Margin="0,0,15,0"/>

                <TextBlock x:Name="PageInfoText" 
                       VerticalAlignment="Center" 
                       Margin="10,0"
                       
                       FontSize="14"/>
            </StackPanel>
        </Border>

        <!-- Область содержимого -->
        <Border Grid.Row="2" CornerRadius="4" Margin="0,10" Background="White" 
            BorderThickness="1">
            <ScrollViewer x:Name="ContentScrollViewer" 
                      VerticalScrollBarVisibility="Auto"
                      Padding="20"
                      UseLayoutRounding="True">
                <TextBox x:Name="ContentTextBox" 
                     TextWrapping="Wrap"
                     IsReadOnly="True"
                     FontFamily="Georgia"
                     FontSize="16"
                     Background="Transparent"
                     BorderThickness="0"/>
            </ScrollViewer>
        </Border>

        <!-- Нижняя панель -->
        <Grid Grid.Row="3" Margin="0,10,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Номер страницы -->
            <TextBlock x:Name="NumberPageFromBook" 
                   Grid.Column="2"
                   HorizontalAlignment="Right" 
                   VerticalAlignment="Center"
                   FontSize="14"/>

            <!-- Навигация -->
            <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center">
                <Button x:Name="PrevPageBtn" 
                    Background="{DynamicResource SecundaryBackgroundColor}" 
                    Foreground="{DynamicResource PrimaryBackgroundColor}"
                    Content="◄"
                    Click="PrevPageBtn_Click"
                    Margin="0,0,10,0"/>

                <Button x:Name="NextPageBtn" 
                    Background="{DynamicResource SecundaryBackgroundColor}" 
                    Foreground="{DynamicResource PrimaryBackgroundColor}"
                    Content="►"
                    Click="NextPageBtn_Click"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
