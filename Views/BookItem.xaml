<UserControl x:Class="WPFBookStore.Views.BookItem"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:WPFBookStore.Views"
             mc:Ignorable="d" 
             d:DesignHeight="250" d:DesignWidth="200">
    <Border Background="#FFF5F5F5" CornerRadius="8" Padding="10">
        <StackPanel>
            <!-- Обложка -->
            <Image Source="{Binding Cover}" 
               Height="120" 
               Stretch="UniformToFill"/>

            <!-- Название -->
            <TextBlock Text="{Binding Title}" 
                   FontWeight="Bold"
                   Margin="0,10,0,0"/>

            <!-- Автор (Фамилия + Имя) -->
            <TextBlock Text="{Binding Author.LastNameAutor}"
                   Margin="0,5,0,0"/>
            <TextBlock Text="{Binding Author.FirstNameAutor}"
                   Foreground="#666"/>
        </StackPanel>
    </Border>
</UserControl>
